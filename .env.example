# Copy to .env. Placeholder values only, for local demo use.
POSTGRES_DB=harbor
POSTGRES_USER=harbor
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5442
APP_DB_PASSWORD=change-me-app-local
LEGACY_PORT=8081
MODERN_PORT=8082
GATEWAY_PORT=8080
HARBOR_JOBS_ENABLED=false
# Signs the cookie both apps share (at least 32 bytes). Generate your own, for example: openssl rand -base64 48
HARBOR_AUTH_SECRET=change-me-auth-secret-min-32-characters
# Demo only: lets the modern app start with the placeholder above. Remove it once you set a real secret.
HARBOR_AUTH_ALLOW_PLACEHOLDER=true
# Set to true when the apps are served over https.
HARBOR_COOKIE_SECURE=false
